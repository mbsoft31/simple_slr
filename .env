# Example Environment Variables
# Copy this file to .env and fill in your actual API keys

# ============================================
# REQUIRED API KEYS
# ============================================

# Semantic Scholar API Key (Free for academic use)
# Get your key at: https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=uTidBRBVjr1MfG60RC4HV5Mkj98iSzOW7fIiFnqh

# Clarivate Web of Science API Key
# Requires institutional subscription
# Contact your library or get API access at: https://developer.clarivate.com/
CLARIVATE_API_KEY=cbd449f75fe3ybc2179643d9eaaf80a088af355b7

# Scopus API Key (Elsevier)
# Requires institutional subscription
# Get API key at: https://dev.elsevier.com/
SCOPUS_API_KEY=e8c507f0ce83e5965fe507d401adf12d
SCOPUS_APP_URL="https://mouadh.tech"
SCOPUS_APP_LABEL="ai_research"

# ============================================
# OPTIONAL SETTINGS
# ============================================

# Crossref Email (for polite pool - higher rate limits)
# Crossref API is free, providing email gets you faster service
CROSSREF_EMAIL=bekhouche.mouadh@univ-oeb.dz

# Database URL (SQLite by default)
DATABASE_URL=sqlite:///scoping_review.db

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO


# ============================================
# NOTES
# ============================================
#
# 1. Semantic Scholar:
#    - Free for academic use
#    - Apply at: https://www.semanticscholar.org/product/api
#    - Usually approved within 24-48 hours
#
# 2. Clarivate Web of Science:
#    - Requires institutional subscription
#    - Contact your university library
#    - Alternative: WoS Lite (limited free version)
#
# 3. Scopus:
#    - Requires institutional subscription
#    - Contact your university library
#    - Some universities provide API access
#
# 4. Crossref & arXiv:
#    - No API key required
#    - Completely free to use
#
# 5. If you don't have access to paid databases:
#    - The pipeline will still work with Semantic Scholar, Crossref, and arXiv
#    - This covers ~200M+ papers (still comprehensive!)
#    - You can disable paid databases in config/database_config.py
